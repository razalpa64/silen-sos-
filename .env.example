# Silent SOS+ environment variables
#
# Local development uses the sandbox Postgres:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production (Neon / Supabase / Vercel Postgres): paste the POOLED connection
# string from your provider. It must include SSL. Examples:
#
# Neon (pooled):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# Supabase (transaction pooler, port 6543):
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

DATABASE_URL=
